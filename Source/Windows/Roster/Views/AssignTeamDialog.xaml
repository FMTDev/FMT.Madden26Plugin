<Window x:Class="Madden26Plugin.Roster.Views.AssignTeamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Team"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Margin="0,0,0,8" FontWeight="Bold"/>

        <Label Grid.Row="1" Content="Conference:"/>
        <ComboBox x:Name="ConferenceCombo" Grid.Row="2" IsEditable="True"
                  SelectionChanged="ConferenceCombo_SelectionChanged"/>

        <Label Grid.Row="3" Content="Team:"/>
        <ComboBox x:Name="TeamCombo" Grid.Row="4" IsEditable="True"/>

        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
