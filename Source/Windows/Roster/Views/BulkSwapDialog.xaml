<Window x:Class="Madden26Plugin.Roster.Views.BulkSwapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Swap Equipment"
        Width="500" Height="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Replace all instances of one equipment value with another." TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Label Grid.Row="1" Content="Find:"/>
        <ComboBox x:Name="FindComboBox" Grid.Row="2" IsEditable="True" Margin="0,0,0,8"/>

        <Label Grid.Row="3" Content="Replace with:"/>
        <ComboBox x:Name="ReplaceComboBox" Grid.Row="4" IsEditable="True" Margin="0,0,0,8"/>

        <TextBlock x:Name="PreviewText" Grid.Row="5" Foreground="Gray" VerticalAlignment="Bottom"/>

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Apply" Width="80" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
