<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Configurations>Debug;Release;FMT_PRO</Configurations>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
	<AssemblyVersion>26.0.0.0</AssemblyVersion>
	<FileVersion>26.11.9680.0</FileVersion>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\CFB27Profile.json" Link="CFB27Profile.json" />
    <Content Include="..\..\Madden26Profile.json" Link="Madden26Profile.json" />
    <Content Include="..\..\Madden27Profile.json" Link="Madden27Profile.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
	  <PackageReference Include="HashDepot" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.Compilers\FMT.Compilers.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.Core\FMT.Core.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.DbObject\FMT.Db.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.FileTools\FMT.FileTools.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.Models.Assets\FMT.Models.Assets.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.PluginInterfaces\FMT.PluginInterfaces.csproj" />
	  <ProjectReference Include="..\..\..\..\Libraries\Internal\FMT.ProfileSystem\FMT.ProfileSystem.csproj" />
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>False</DebugSymbols>
		<DebugType>None</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='FMT_PRO'">
	  <DebugSymbols>False</DebugSymbols>
	  <DebugType>None</DebugType>
	</PropertyGroup>

  <ItemGroup>
    <None Update="FMTIcon24.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Update="Madden26Cover.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		<PackagePath>\</PackagePath>
		<Pack>True</Pack>
    </None>
    <None Update="Madden27Profile.json">
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
    </None>
    <None Update="Madden26Profile.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		<PackagePath>\</PackagePath>
		<Pack>True</Pack>
    </None>
  </ItemGroup>

  <!-- Force WPF MarkupCompilePass1 to ensure .g.cs and .baml are generated -->
  <PropertyGroup>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
  </PropertyGroup>

  
</Project>
