<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<UseWPF>true</UseWPF>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Configurations>Debug;Release;FMT_PRO</Configurations>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
	<AssemblyVersion>26.0.0.0</AssemblyVersion>
	<FileVersion>26.11.9680.0</FileVersion>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Launcher\dpapi.dll" />
    <None Remove="Launcher\EAAntiCheat.GameServiceLauncher.exe" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Launcher\CryptBase.dll" />
    <EmbeddedResource Include="Launcher\dpapi.dll" />
    <EmbeddedResource Include="Launcher\EAAntiCheat.GameServiceLauncher.exe" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="RosterAnalyzer\**" />
    <EmbeddedResource Remove="RosterAnalyzer\**" />
    <None Remove="RosterAnalyzer\**" />

    <Compile Remove="Tools\**" />
    <Compile Remove="Launcher\*.cs" />
    <Compile Remove="TestDeflate.cs" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="FMT.Compilers" Version="2026.1.1" />
    <PackageReference Include="FMT.FileTools" Version="2026.3.3" />
	<PackageReference Include="FMT.Core" Version="2026.8.1" />

	<PackageReference Include="HashDepot" Version="3.2.0" />
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>False</DebugSymbols>
		<DebugType>None</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='FMT_PRO'">
	  <DebugSymbols>False</DebugSymbols>
	  <DebugType>None</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE.md" Pack="true" PackagePath="\" />
	</ItemGroup>

  <ItemGroup>
    <None Update="FMTIcon24.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Update="Madden26Cover.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		<PackagePath>\</PackagePath>
		<Pack>True</Pack>
    </None>
    <None Update="Madden27Profile.json">
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
    </None>
    <None Update="Madden26Profile.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		<PackagePath>\</PackagePath>
		<Pack>True</Pack>
    </None>
  </ItemGroup>

  <!-- Force WPF MarkupCompilePass1 to ensure .g.cs and .baml are generated -->
  <PropertyGroup>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
  </PropertyGroup>

  <!-- Embed WPF-generated BAML as resources so LoadComponent() can find them -->
  <Target Name="EmbedBamlResources" BeforeTargets="AssignTargetPaths" Condition="'$(UseWPF)'=='true'">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Roster\Views\RosterEditorWindow.baml">
        <LogicalName>$(RootNamespace).Roster.Views.RosterEditorWindow.baml</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(IntermediateOutputPath)Roster\Views\GenerateRosterDialog.baml">
        <LogicalName>$(RootNamespace).Roster.Views.GenerateRosterDialog.baml</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(IntermediateOutputPath)Roster\Views\BulkSwapDialog.baml">
        <LogicalName>$(RootNamespace).Roster.Views.BulkSwapDialog.baml</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
